#
# wm independent hotkeys
#

#Terminal
super + Return
	terminal
# File Manager
super + e
	files
# Web Browser
super + w
	browser
# program launcher
super + @space
	rofi -show drun

# window switcher
alt + Tab
	rofi -show window

# sxhkd reload
super + Escape
	pkill -USR1 -x sxhkd

# Cheatsheet
super + F1
	/home/ahmed/projects/dotconfig/scripts/cheatsheet.sh



#
# bspwm hotkeys
#

# quit/restart bspwm
ctrl + super + {q,r}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh {quit,wm -r}

# close and kill
super + {_,shift + }q
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -{c,k}

# alternate between the tiled and monocle layout
super + m
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh desktop -l next

# send the newest marked node to the newest preselected node
super + y
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node newest.marked.local -n newest.!automatic.local

# swap the current node and the biggest window
super + g
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -s biggest.window

#
# state/flags
#

super + f
    [ -z "$(/home/ahmed/projects/dotconfig/scripts/wm-run.sh query -N -n .focused.fullscreen)" ] && /home/ahmed/projects/dotconfig/scripts/wm-run.sh node focused -t fullscreen ||  /home/ahmed/projects/dotconfig/scripts/wm-run.sh node focused -t tiled

# set the window state
super + {t,shift + t,s}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -t {tiled,pseudo_tiled,floating}

# set the node flags
super + ctrl + {m,x,y,z}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -g {marked,locked,sticky,private}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift + }{h,j,k,l}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -f @{parent,brother,first,second}

# focus the next/previous window in the current desktop
# super + {_,shift + }c
# 	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -f {next,prev}.local.!hidden.window
super + {Right,Left,Up,Down}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -f {east,west,north,south}.local.!hidden.window

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh desktop -f {prev,next}.local

# focus the last node/desktop
super + {grave,Tab}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh {node,desktop} -f last

# focus the older or newer node in the focus history
super + {o,i}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh wm -h off; \
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node {older,newer} -f; \
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh wm -h on

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh {desktop -f,node -d} '^{1-9,10}'
super + {_,shift + }KP_End
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh {desktop -f,node -d} '^1'
super + KP_Down
	~/.config/bspwm/workspaces/2.sh 
super + shift + KP_Down
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^2'
super + KP_Next
	~/.config/bspwm/workspaces/3.sh 
super + shift + KP_Next
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^3'
super + KP_Left
	~/.config/bspwm/workspaces/4.sh 
super + shift + KP_Left
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^4'
super + KP_Begin
   ~/.config/bspwm/workspaces/5.sh 
super + shift + KP_Begin
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^5'
super + KP_Right
   ~/.config/bspwm/workspaces/6.sh 
super + shift + KP_Right
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^6'
super + KP_Insert
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh desktop -f '^7'	
super + shift + KP_Insert
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -d '^7'	
# preselect
#

# preselect the direction
super + ctrl + {h,j,k,l}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -p {west,south,north,east}



# preselect the ratio
super + ctrl + {1-9}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh query -N -d | xargs -I id -n 1 /home/ahmed/projects/dotconfig/scripts/wm-run.sh node id -p cancel

#
# move/resize
#


super + button{4,5}
    /home/ahmed/projects/dotconfig/scripts/wm-run.sh desktop {prev,next}.occupied -f

# expand a window by moving one of its side outward
super + alt + {Left,Down,Up,Right}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + shift + {Left,Down,Up,Right}
	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
# super + {Left,Down,Up,Right}
# 	/home/ahmed/projects/dotconfig/scripts/wm-run.sh node -v {-20 0,0 20,0 -20,20 0}

# Lock Screen
ctrl + alt + l
	loginctl lock-session
	# betterlockscreen -l

ctrl + alt + q
	systemctl suspend
	# betterlockscreen -l

ctrl + alt + Delete
	systemctl reboot

XF86AudioLowerVolume
	pactl -- set-sink-volume 0 -10%

XF86AudioRaiseVolume
	pactl -- set-sink-volume 0 +10%

XF86AudioMute
	pactl -- set-sink-mute 0 toggle

# Monitor Brightness (ddcutil)
super + bracketleft
	ddcutil setvcp 10 - 10
super + bracketright
	ddcutil setvcp 10 + 10
{Print,super + shift + s}
	flameshot gui

# PyWallpaper Theme Selection
super + alt + w
	$HOME/projects/dotconfig/scripts/pywallpaper.sh

# Reload Polybar
super + alt + p
	/home/ahmed/projects/dotconfig/modules/bar/polybar/.config/polybar/launch.sh


super + alt + r
	bspc wm -r
